# Пути к обученным моделям CatBoost внутри контейнера (том models/ смонтирован
# из ./ml/models — см. compose.yaml). Пока файлов нет, /classify отвечает 503,
# а бэкенд сам откатывается на правила (RuleBasedClassifier).
CATEGORY_MODEL_PATH=models/category_classifier.cbm
EMERGENCY_MODEL_PATH=models/emergency_classifier.cbm

LOG_LEVEL=INFO

# Генерация датасета через OpenRouter API (ml/dataset/generate.py)
# !!!
OPENROUTER_API_KEY=
# !!!
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Настройки выбора провайдера OpenRouter (например: order=Chutes или sort=price)
# у стрим лейк скидка 88%
OPENROUTER_PROVIDER_ORDER=StreamLake
OPENROUTER_PROVIDER_SORT=price
