# Bot token issued by the hackathon organisers. Never commit a real value.
MAX_TOKEN=

LOG_LEVEL=INFO

# PostgreSQL. In docker compose this is overridden to point at the `db` service.
DATABASE_URL=postgresql+asyncpg://domovoy:domovoy@localhost:5432/domovoy

# How MAX updates arrive:
#   polling  - local development, no public URL needed;
#   webhook  - production, HTTPS on 443 via Caddy (docker compose --profile prod).
BOT_MODE=polling
WEBHOOK_URL=
# 5-256 chars, [a-zA-Z0-9_-]; MAX sends it back in X-Max-Bot-Api-Secret.
WEBHOOK_SECRET=
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Hosted LLM behind an OpenAI-compatible API (DECISIONS D-007), off by default.
# Yandex AI Studio: LLM_MODEL=gpt://<folder_id>/yandexgpt/latest, key of a service account.
LLM_ENABLED=false
LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SEC=20
LLM_TEMPERATURE=0.2

# Complaint classification service (DECISIONS D-005, D-006). If it is down or
# has no trained models, the bot falls back to keyword rules.
ML_SERVICE_URL=http://localhost:8100
ML_SERVICE_TIMEOUT_SEC=3
ML_CONFIDENCE_THRESHOLD=0.6
