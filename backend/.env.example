# Токен бота MAX (выдан организаторами хакатона; настройки бота — на business.max.ru).
# Реальные токены в репозиторий не коммитятся.
MAX_TOKEN=

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Интеграция с системой управляющей организации.
# Пусто + UK_MOCK_MODE=true -> модельная (mock) интеграция.
UK_API_URL=
UK_API_TOKEN=
UK_MOCK_MODE=true

# Демонстрационная автосмена статусов заявки после отправки.
DEMO_STATUS_SIMULATION=true
DEMO_STATUS_DELAY_SEC=25

# Дообученная модель (обслуживается отдельно, OpenAI-совместимый API).
# LLM_ENABLED=false -> бот работает на заглушке StubAIService.
LLM_ENABLED=false
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=smart-city-jkh
LLM_API_KEY=
LLM_TIMEOUT_SEC=20
LLM_TEMPERATURE=0.2

# Классификация жалоб: категория + аварийность (DECISIONS D-005, D-006).
# Отдельный сервис (ml/, свой контейнер в compose.yaml). Если недоступен
# или модели ещё не обучены — бот сам откатывается на RuleBasedClassifier
# (ключевые слова), без падений и без изменений в коде.
ML_SERVICE_URL=http://localhost:8100
ML_SERVICE_TIMEOUT_SEC=3
ML_CONFIDENCE_THRESHOLD=0.6
