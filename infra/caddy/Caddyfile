# Public HTTPS entry point (production profile). Caddy obtains a Let's Encrypt
# certificate for $DOMAIN automatically; MAX requires HTTPS on port 443.
{$DOMAIN} {
	encode zstd gzip

	# Webhook, REST (/api), ops and the mini-app (/) are all served by the
	# backend container; Caddy only terminates TLS.
	handle {
		reverse_proxy bot:8080
	}
}
